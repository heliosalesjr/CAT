# Copy to .env.local and fill in. Next loads .env.local; a plain shell does
# not, which is why the db scripts take DATABASE_URL on the command line.
#
# Nothing here is a secret — that is the point of the file. `.gitignore`
# ignores every .env* except this one.

# The POOLED Neon host (the hostname contains "-pooler"), with
# sslmode=verify-full. The app keeps a small pool per instance and lets Neon's
# pooler do the concentrating.
DATABASE_URL=''

# The DIRECT host (no "-pooler"), for migrations and seeds. Neon's pooler is
# PgBouncer in transaction mode: right for the app, awkward for DDL.
#
#   DATABASE_URL="$(grep -m1 '^DATABASE_URL_DIRECT=' .env.local | cut -d= -f2- | tr -d "'")" npm run db:migrate
#
# `npm run admin` and `npm run db:doctor` read this file and need no prefix.
DATABASE_URL_DIRECT=''

# Signs the session cookie. A different one per environment; changing it signs
# everybody out, which is all it does.
#   openssl rand -base64 32
AUTH_SECRET=''

# 'console' prints every email to the terminal and writes the link to
# .next/last-email-link (npm run signin). It refuses to start in production,
# because that would print credentials to a log.
EMAIL_TRANSPORT='console'
