{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "terrain": "python3 scripts/generate-terrain.py",
    "db:migrate": "node db/migrate.mjs",
    "db:migrate:dry": "node db/migrate.mjs --dry-run",
    "db:seed": "node db/seed.mjs",
    "db:check": "node db/check.mjs",
    "db:types": "node db/types.mjs",
    "db:types:check": "node db/types.mjs --check",
    "db:smoke": "node --experimental-strip-types --conditions=react-server --no-warnings db/smoke.ts",
    "db:seed:check": "node db/seed.mjs --check-only",
    "db:reset": "ALLOW_RESET=1 node db/seed.mjs --reset"
  },
  "dependencies": {
    "@auth/pg-adapter": "^1.11.3",
    "next": "16.3.5",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.13.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
